{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/demo",
      "destination": "https://dashboard-demo-iota-bice.vercel.app/demo"
    },
    {
      "source": "/demo/:path*",
      "destination": "https://dashboard-demo-iota-bice.vercel.app/demo/:path*"
    },
    {
      "source": "/review",
      "destination": "https://toa-review.vercel.app/review"
    },
    {
      "source": "/review/:path*",
      "destination": "https://toa-review.vercel.app/review/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/plainview",
      "destination": "/that-other-dashboard",
      "permanent": true
    },
    {
      "source": "/plainview/:path*",
      "destination": "/that-other-dashboard/:path*",
      "permanent": true
    }
  ]
}
